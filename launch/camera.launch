<?xml version="1.0"?>
<launch>
    <arg name="camera_name" default="lower_legs_camera"/>
    <!-- <arg name="camera_name" default="upper_body_camera"/> -->

    <arg if="$(eval camera_name == 'lower_legs_camera')" name="device_id" value="1@0"/>
    <arg if="$(eval camera_name == 'upper_body_camera')" name="device_id" value="3@0"/>

    <include file="$(find openni2_launch)/launch/openni2.launch" >
        <!-- Launch arguments https://wiki.ros.org/openni_launch -->
        <arg name="camera" value="$(arg camera_name)"/>
        <arg name="device_id" value="$(arg device_id)"/>
        <!-- <arg name="depth_mode" value="2"/> -->
        <!-- <arg name="data_skip" default="0"/> -->
        <arg name="num_worker_threads" default="4"/>
		<arg name="rgb_frame_id" value="$(arg camera_name)_rgb_optical_frame"/>
		<arg name="depth_frame_id" value="$(arg camera_name)_depth_optical_frame"/>
		<arg name="publish_tf" value="true"/>
        <arg name="depth_registration" value="true"/>

        <!-- Launch arguments from rgbd_launch https://wiki.ros.org/rgbd_launch -->
        <arg name="rgb_processing" value="true"/> 
        <arg name="debayer_processing" value="false" />
        <arg name="ir_processing" value="false" />
        <arg name="depth_processing" value="false" />
        <arg name="depth_registered_processing" value="true" />
        <arg name="disparity_processing" value="false" />
        <arg name="sw_registered_processing" value="false" />
        <arg name="hw_registered_processing" value="true" />
    </include>

</launch>
